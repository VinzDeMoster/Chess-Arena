{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'player') || (data.exists() && newData.child('role').val() === data.child('role').val()))))",
        "history": {
          "$historyId": {
            ".write": "auth != null && auth.uid === $uid",
            ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          },
          ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "chats": {
      "$room": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500",
          ".validate": "newData.hasChildren(['uid','name','text','createdAt'])"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid)) || (!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('status').val() === 'waiting' && !data.child('guestUid').exists() && newData.child('guestUid').val() === auth.uid && newData.child('hostUid').val() === data.child('hostUid').val()))"
      }
    },
    "matchmaking": {
      "$mode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "announcements": {
      "current": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}